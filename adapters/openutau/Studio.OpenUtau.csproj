<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="'$(OpenUtauSource)' != ''">
    <ProjectReference Include="$(OpenUtauSource)/OpenUtau.Core/OpenUtau.Core.csproj" />
    <ProjectReference Include="$(OpenUtauSource)/OpenUtau.Plugin.Builtin/OpenUtau.Plugin.Builtin.csproj" />
    <None Include="$(OpenUtauSource)/runtimes/win-x64/native/worldline.dll"
          Link="worldline.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(OpenUtauSource)/LICENSE.txt" Link="OpenUtau-LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.15" />
  </ItemGroup>
  <Target Name="RequireOpenUtauSource" BeforeTargets="ResolveProjectReferences" Condition="'$(OpenUtauSource)' == ''">
    <Error Text="Set OpenUtauSource to the pinned OpenUtau source directory." />
  </Target>
</Project>
